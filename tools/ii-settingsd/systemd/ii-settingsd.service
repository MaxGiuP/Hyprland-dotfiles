[Unit]
Description=Illogical Impulse native settings service
Documentation=file:%h/.local/share/doc/ii-settingsd/README.md
After=dbus.socket

[Service]
Type=simple
ExecStart=%h/.local/bin/ii-settingsd serve
Restart=on-failure
RestartSec=1s
RuntimeDirectory=ii-settingsd
RuntimeDirectoryMode=0700
UMask=0077

# The service only needs its private Unix socket, read-only system inventory,
# and outbound calls to the system D-Bus.
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=default.target
