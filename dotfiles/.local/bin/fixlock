#!/usr/bin/env bash
set -euo pipefail

MAX_TTY="${FIXLOCK_MAX_TTY:-12}"

detect_active_vt() {
    local active
    active="$(cat /sys/class/tty/tty0/active 2>/dev/null || true)"
    active="${active#tty}"

    if [[ "$active" =~ ^[0-9]+$ ]]; then
        printf '%s\n' "$active"
    else
        printf '1\n'
    fi
}

detect_sddm_greeter_session() {
    loginctl list-sessions --no-legend 2>/dev/null |
        awk '$6 == "greeter" { print $1; exit }'
}

detect_sddm_greeter_vt() {
    local vt

    vt="$(
        loginctl list-sessions --no-legend 2>/dev/null |
            awk '$6 == "greeter" && $7 ~ /^tty[0-9]+$/ { sub(/^tty/, "", $7); print $7; exit }'
    )"

    if [[ "$vt" =~ ^[0-9]+$ ]]; then
        printf '%s\n' "$vt"
        return 0
    fi

    vt="$(
        pgrep -af 'Xorg .* vt[0-9]+' 2>/dev/null |
            sed -n 's/.* vt\([0-9]\+\).*/\1/p' |
            head -n 1 || true
    )"

    if [[ "$vt" =~ ^[0-9]+$ ]]; then
        printf '%s\n' "$vt"
    fi
}

detect_session_vts() {
    loginctl list-sessions --no-legend 2>/dev/null |
        awk '$7 ~ /^tty[0-9]+$/ {
            sub(/^tty/, "", $7)
            if (!seen[$7]++) print $7
        }'
}

collect_reset_ttys() {
    local active_vt="$1"
    shift
    local protected_vts=("$@")
    local protected_vt
    local vt

    for ((vt = 1; vt <= MAX_TTY; vt++)); do
        [[ "$vt" -eq "$active_vt" ]] && continue
        [[ -e "/dev/tty$vt" ]] || continue

        for protected_vt in "${protected_vts[@]}"; do
            if [[ "$protected_vt" =~ ^[0-9]+$ && "$vt" -eq "$protected_vt" ]]; then
                continue 2
            fi
        done

        printf '%s\n' "$vt"
    done
}

pick_fallback_vt() {
    local active_vt="$1"
    shift
    local vt

    while IFS= read -r vt; do
        printf '%s\n' "$vt"
        return 0
    done < <(collect_reset_ttys "$active_vt" "$@")

    printf '%s\n' "$active_vt"
}

reset_ttys_as_root() {
    local active_vt="$1"
    local fallback_vt="$2"
    shift 2
    local protected_vts=("$@")
    local vt

    echo "Resetting TTYs (active: tty${active_vt}, fallback: tty${fallback_vt})."
    if ((${#protected_vts[@]} > 0)); then
        echo "Protecting TTYs used by live sessions or the display manager: ${protected_vts[*]}."
    fi

    while IFS= read -r vt; do
        systemctl reset-failed "getty@tty${vt}.service" >/dev/null 2>&1 || true
        systemctl restart "getty@tty${vt}.service" >/dev/null 2>&1 || true

        if [[ -w "/dev/tty${vt}" ]]; then
            printf '\033c' >"/dev/tty${vt}" || true
        fi

        if command -v deallocvt >/dev/null 2>&1; then
            deallocvt "$vt" >/dev/null 2>&1 || true
        fi
    done < <(collect_reset_ttys "$active_vt" "${protected_vts[@]}")

    if [[ "$fallback_vt" != "$active_vt" ]]; then
        chvt "$fallback_vt"
        sleep 0.25
    fi

    chvt "$active_vt"
    sleep 0.1
}

run_root_helper() {
    local active_vt="$1"
    local fallback_vt="$2"
    shift 2
    local protected_vts=("$@")

    if [[ "${EUID}" -eq 0 ]]; then
        reset_ttys_as_root "$active_vt" "$fallback_vt" "${protected_vts[@]}"
        return 0
    fi

    if sudo -n true >/dev/null 2>&1; then
        sudo -n "$0" --root-helper "$active_vt" "$fallback_vt" "${protected_vts[@]}"
        return 0
    fi

    if [[ -t 0 && -t 1 ]]; then
        sudo "$0" --root-helper "$active_vt" "$fallback_vt" "${protected_vts[@]}"
        return 0
    fi

    echo "Warning: TTY reset needs sudo. Re-run 'sudo fixlock' if the VTs stay broken." >&2
    return 1
}

activate_login_screen_as_root() {
    local target_vt="$1"
    local greeter_session="${2:-}"

    if [[ "$target_vt" == "restart" ]]; then
        echo "Restarting sddm.service to restore the login screen."
        systemctl restart sddm.service
        sleep 1
        target_vt="$(detect_sddm_greeter_vt)"
        greeter_session="$(detect_sddm_greeter_session)"
    fi

    if [[ -n "$greeter_session" ]]; then
        loginctl activate "$greeter_session" >/dev/null 2>&1 || true
    fi

    if [[ "$target_vt" =~ ^[0-9]+$ ]]; then
        chvt "$target_vt"
        echo "Switched to tty${target_vt}."
        return 0
    fi

    echo "Warning: unable to find the SDDM greeter VT." >&2
    return 1
}

run_login_screen_helper() {
    local target_vt="$1"
    local greeter_session="${2:-}"

    if [[ "${EUID}" -eq 0 ]]; then
        activate_login_screen_as_root "$target_vt" "$greeter_session"
        return $?
    fi

    if sudo -n true >/dev/null 2>&1; then
        sudo -n "$0" --login-screen-helper "$target_vt" "$greeter_session"
        return $?
    fi

    if [[ -t 0 && -t 1 ]]; then
        sudo "$0" --login-screen-helper "$target_vt" "$greeter_session"
        return $?
    fi

    echo "Warning: switching to the login screen needs sudo. Re-run 'sudo fixlock'." >&2
    return 1
}

recover_login_screen() {
    local active_vt="$1"
    local fallback_vt="$2"
    local skip_root_helper="${3:-0}"
    local greeter_session
    local sddm_vt

    sddm_vt="$(detect_sddm_greeter_vt)"
    greeter_session="$(detect_sddm_greeter_session)"

    if [[ -n "$sddm_vt" ]]; then
        echo "No running Hyprland instances found."
        echo "SDDM greeter is on tty${sddm_vt}; switching there."

        if [[ "$skip_root_helper" != "1" ]]; then
            run_root_helper "$active_vt" "$fallback_vt" "$sddm_vt" || true
        fi

        run_login_screen_helper "$sddm_vt" "$greeter_session"
        return $?
    fi

    echo "No running Hyprland instances or SDDM greeter found." >&2
    run_login_screen_helper restart
}

run_user_recovery() {
    local active_vt="$1"
    local fallback_vt="$2"
    local skip_root_helper="${3:-0}"
    local instance
    local launched_hyprlock=0

    mapfile -t instances < <(hyprctl instances 2>/dev/null | awk '/^instance /{gsub(":", "", $2); print $2}')

    if ((${#instances[@]} == 0)); then
        recover_login_screen "$active_vt" "$fallback_vt" "$skip_root_helper"
        exit $?
    fi

    echo "Targeting Hyprland instances: ${instances[*]}"
    for instance in "${instances[@]}"; do
        hyprctl --instance "$instance" keyword misc:allow_session_lock_restore 1 >/dev/null 2>&1 || true
    done
    echo "Enabled session lock restore on all instances."

    if killall -9 hyprlock 2>/dev/null; then
        echo "Killed existing hyprlock process(es)."
    else
        echo "No existing hyprlock processes found."
    fi

    for instance in "${instances[@]}"; do
        if hyprctl --instance "$instance" "dispatch exec hyprlock" >/dev/null 2>&1; then
            echo "Started hyprlock on instance $instance."
            launched_hyprlock=1
        else
            echo "Warning: failed to start hyprlock on instance $instance." >&2
        fi
    done

    if [[ "$launched_hyprlock" -eq 0 ]]; then
        echo "Warning: unable to launch hyprlock on any Hyprland instance." >&2
    fi
}

if [[ "${1:-}" == "--root-helper" ]]; then
    shift
    active_vt="${1:?missing active vt}"
    fallback_vt="${2:?missing fallback vt}"
    shift 2
    reset_ttys_as_root "$active_vt" "$fallback_vt" "$@"
    exit 0
fi

if [[ "${1:-}" == "--login-screen-helper" ]]; then
    shift
    activate_login_screen_as_root "${1:?missing target vt}" "${2:-}"
    exit 0
fi

if [[ "${1:-}" == "--user-recovery" ]]; then
    shift
    run_user_recovery "${1:?missing active vt}" "${2:?missing fallback vt}" 1
    exit 0
fi

active_vt="$(detect_active_vt)"
sddm_vt="$(detect_sddm_greeter_vt)"
mapfile -t protected_vts < <(detect_session_vts)
if [[ -n "$sddm_vt" ]]; then
    sddm_vt_seen=0
    for protected_vt in "${protected_vts[@]}"; do
        if [[ "$protected_vt" == "$sddm_vt" ]]; then
            sddm_vt_seen=1
            break
        fi
    done
    if [[ "$sddm_vt_seen" -eq 0 ]]; then
        protected_vts+=("$sddm_vt")
    fi
fi
fallback_vt="$(pick_fallback_vt "$active_vt" "${protected_vts[@]}")"

if [[ "${EUID}" -eq 0 && -n "${SUDO_USER:-}" && -n "${SUDO_UID:-}" ]]; then
    user_home="$(getent passwd "$SUDO_USER" | cut -d: -f6)"

    mapfile -t root_seen_instances < <(runuser -u "$SUDO_USER" -- env \
        HOME="$user_home" \
        XDG_RUNTIME_DIR="/run/user/${SUDO_UID}" \
        PATH="$PATH" \
        hyprctl instances 2>/dev/null |
            awk '/^instance /{gsub(":", "", $2); print $2}')

    if ((${#root_seen_instances[@]} > 0)); then
        exec runuser -u "$SUDO_USER" -- env \
            HOME="$user_home" \
            XDG_RUNTIME_DIR="/run/user/${SUDO_UID}" \
            PATH="$PATH" \
            "$0" --user-recovery "$active_vt" "$fallback_vt"
    fi

    reset_ttys_as_root "$active_vt" "$fallback_vt" "${protected_vts[@]}"
    if [[ -n "$sddm_vt" ]]; then
        activate_login_screen_as_root "$sddm_vt" "$(detect_sddm_greeter_session)"
    else
        activate_login_screen_as_root restart
    fi
    exit $?
fi

run_user_recovery "$active_vt" "$fallback_vt"
