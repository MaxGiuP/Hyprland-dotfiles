#!/usr/bin/env bash
set -euo pipefail

# Recovery contract, learned from the 2026-08-26 TTY1 lock failure:
# - never reset a VT while a live session may own it;
# - if Hyprland is alive, restore the lock with hyprlock in that instance;
# - if Hyprland died, stop stale shell services, start SDDM, and switch to it.

detect_sddm_greeter_session() {
    loginctl list-sessions --no-legend 2>/dev/null |
        awk '$6 == "greeter" { print $1; exit }'
}

detect_sddm_greeter_vt() {
    local vt

    vt="$(
        loginctl list-sessions --no-legend 2>/dev/null |
            awk '$6 == "greeter" && $7 ~ /^tty[0-9]+$/ { sub(/^tty/, "", $7); print $7; exit }'
    )"

    if [[ "$vt" =~ ^[0-9]+$ ]]; then
        printf '%s\n' "$vt"
        return 0
    fi

    vt="$(
        pgrep -af 'Xorg .* vt[0-9]+' 2>/dev/null |
            sed -n 's/.* vt\([0-9]\+\).*/\1/p' |
            head -n 1 || true
    )"

    if [[ "$vt" =~ ^[0-9]+$ ]]; then
        printf '%s\n' "$vt"
    fi
}

activate_login_screen_as_root() {
    local target_vt="$1"
    local greeter_session="${2:-}"

    if [[ "$target_vt" == "restart" ]]; then
        echo "Starting sddm.service to restore the login screen."
        systemctl reset-failed sddm.service >/dev/null 2>&1 || true
        systemctl start sddm.service

        for _ in {1..50}; do
            target_vt="$(detect_sddm_greeter_vt)"
            greeter_session="$(detect_sddm_greeter_session)"
            [[ "$target_vt" =~ ^[0-9]+$ ]] && break
            sleep 0.1
        done
    fi

    if [[ -n "$greeter_session" ]]; then
        loginctl activate "$greeter_session" >/dev/null 2>&1 || true
    fi

    if [[ "$target_vt" =~ ^[0-9]+$ ]]; then
        chvt "$target_vt"
        echo "Switched to tty${target_vt}."
        return 0
    fi

    echo "Warning: unable to find the SDDM greeter VT." >&2
    return 1
}

cleanup_stale_user_services() {
    if ! command -v systemctl >/dev/null 2>&1; then
        return 0
    fi

    echo "Stopping stale Quickshell and hypridle services."
    systemctl --user stop quickshell.service hypridle.service >/dev/null 2>&1 || true
    systemctl --user reset-failed quickshell.service hypridle.service >/dev/null 2>&1 || true
}

list_hyprland_instances() {
    local output

    command -v hyprctl >/dev/null 2>&1 || return 127
    output="$(hyprctl instances 2>/dev/null)" || return $?
    printf '%s\n' "$output" | awk '/^instance /{gsub(":", "", $2); print $2}'
}

run_login_screen_helper() {
    local target_vt="$1"
    local greeter_session="${2:-}"

    if [[ "${EUID}" -eq 0 ]]; then
        activate_login_screen_as_root "$target_vt" "$greeter_session"
        return $?
    fi

    if sudo -n true >/dev/null 2>&1; then
        sudo -n "$0" --login-screen-helper "$target_vt" "$greeter_session"
        return $?
    fi

    if [[ -t 0 && -t 1 ]]; then
        sudo "$0" --login-screen-helper "$target_vt" "$greeter_session"
        return $?
    fi

    echo "Warning: switching to the login screen needs sudo. Re-run 'sudo fixlock'." >&2
    return 1
}

recover_login_screen() {
    local greeter_session
    local sddm_vt

    sddm_vt="$(detect_sddm_greeter_vt)"
    greeter_session="$(detect_sddm_greeter_session)"

    if [[ -n "$sddm_vt" ]]; then
        echo "No running Hyprland instances found."
        echo "SDDM greeter is on tty${sddm_vt}; switching there."

        run_login_screen_helper "$sddm_vt" "$greeter_session"
        return $?
    fi

    echo "No running Hyprland instances or SDDM greeter found." >&2
    run_login_screen_helper restart
}

run_user_recovery() {
    local instance
    local instance_output
    local launched_hyprlock=0

    if ! instance_output="$(list_hyprland_instances)"; then
        echo "Unable to inspect Hyprland instances; refusing unsafe recovery." >&2
        return 1
    fi
    mapfile -t instances < <(printf '%s' "$instance_output")

    if ((${#instances[@]} == 0)); then
        cleanup_stale_user_services
        recover_login_screen
        exit $?
    fi

    echo "Targeting Hyprland instances: ${instances[*]}"
    for instance in "${instances[@]}"; do
        hyprctl --instance "$instance" keyword misc:allow_session_lock_restore 1 >/dev/null 2>&1 || true
    done
    echo "Enabled session lock restore on all instances."

    if killall -9 hyprlock 2>/dev/null; then
        echo "Killed existing hyprlock process(es)."
    else
        echo "No existing hyprlock processes found."
    fi

    for instance in "${instances[@]}"; do
        if hyprctl --instance "$instance" "dispatch exec hyprlock" >/dev/null 2>&1; then
            echo "Started hyprlock on instance $instance."
            launched_hyprlock=1
        else
            echo "Warning: failed to start hyprlock on instance $instance." >&2
        fi
    done

    if [[ "$launched_hyprlock" -eq 0 ]]; then
        echo "Warning: unable to launch hyprlock on any Hyprland instance." >&2
    fi
}

if [[ "${1:-}" == "--login-screen-helper" ]]; then
    shift
    activate_login_screen_as_root "${1:?missing target vt}" "${2:-}"
    exit 0
fi

if [[ "${1:-}" == "--user-recovery" ]]; then
    run_user_recovery
    exit 0
fi

if [[ "${1:-}" == "--cleanup-user-services" ]]; then
    cleanup_stale_user_services
    exit 0
fi

if [[ "${EUID}" -eq 0 && -n "${SUDO_USER:-}" && -n "${SUDO_UID:-}" ]]; then
    user_home="$(getent passwd "$SUDO_USER" | cut -d: -f6)"
    sddm_vt="$(detect_sddm_greeter_vt)"

    if ! root_instance_output="$(runuser -u "$SUDO_USER" -- env \
        HOME="$user_home" \
        XDG_RUNTIME_DIR="/run/user/${SUDO_UID}" \
        PATH="$PATH" \
        hyprctl instances 2>/dev/null)"; then
        echo "Unable to inspect Hyprland instances; refusing unsafe recovery." >&2
        exit 1
    fi
    mapfile -t root_seen_instances < <(
        printf '%s\n' "$root_instance_output" |
            awk '/^instance /{gsub(":", "", $2); print $2}'
    )

    if ((${#root_seen_instances[@]} > 0)); then
        exec runuser -u "$SUDO_USER" -- env \
            HOME="$user_home" \
            XDG_RUNTIME_DIR="/run/user/${SUDO_UID}" \
            PATH="$PATH" \
            "$0" --user-recovery
    fi

    runuser -u "$SUDO_USER" -- env \
        HOME="$user_home" \
        XDG_RUNTIME_DIR="/run/user/${SUDO_UID}" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/${SUDO_UID}/bus" \
        PATH="$PATH" \
        "$0" --cleanup-user-services || true

    if [[ -n "$sddm_vt" ]]; then
        activate_login_screen_as_root "$sddm_vt" "$(detect_sddm_greeter_session)"
    else
        activate_login_screen_as_root restart
    fi
    exit $?
fi

run_user_recovery
