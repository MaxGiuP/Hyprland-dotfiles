[Desktop Entry]
Type=Application
Name=QuickMail
GenericName=Email Client
Comment=Fast local-first mail, accounts and agenda
Exec=/home/linmax/.config/quickshell/ii/scripts/accounts/open-quickmail.sh mail %u
TryExec=/home/linmax/.config/quickshell/ii/scripts/accounts/open-quickmail.sh
Icon=mail-unread-symbolic
Terminal=false
StartupNotify=true
Categories=Network;Email;
Keywords=mail;email;gmail;imap;calendar;agenda;quickmail;
MimeType=x-scheme-handler/mailto;
StartupWMClass=org.quickshell
SingleMainWindow=true
Actions=Accounts;Calendar;

[Desktop Action Accounts]
Name=Accounts
Exec=/home/linmax/.config/quickshell/ii/scripts/accounts/open-quickmail.sh accounts

[Desktop Action Calendar]
Name=Calendar
Exec=/home/linmax/.config/quickshell/ii/scripts/accounts/open-quickmail.sh calendar
