const strings = translations[systemLang.split("-")[0]] || translations.en;
const pad = document.getElementById("pad");
const status = document.getElementById("status");
const keyboardInput = document.getElementById("keyboard-input");
const volumeDial = document.getElementById("volume-dial");
const volumeValue = document.getElementById("volume-value");
const audioOutput = document.getElementById("audio-output");
let last = null;
let lastTap = 0;
let scrollSamples = [];
let didScroll = false;
let touchStartCount = 0;
let touchStartAt = 0;
let touchMoved = false;
let previousKeyboardValue = "";
let keyboardOpenRequested = false;
let volumeTimer = 0;
let populatingOutputs = false;

function applyTranslations() {
  document.querySelectorAll("[data-i18n]").forEach(el => {
    const key = el.getAttribute("data-i18n");
    if (strings[key]) el.textContent = strings[key];
  });
  document.title = strings.title;
  document.getElementById("left").setAttribute("aria-label", strings.click);
  document.getElementById("keyboard").setAttribute("aria-label", strings.type);
  document.getElementById("web-back").setAttribute("aria-label", strings.back);
  document.getElementById("close").setAttribute("aria-label", strings.close || "Close App");
  volumeDial.setAttribute("aria-label", strings.volume);
  audioOutput.setAttribute("aria-label", strings.output);
}

function send(payload) {
  status.textContent = `${payload.type} ${Math.round(payload.dx || 0)}, ${Math.round(payload.dy || 0)}`;
  payload.token = token;
  return fetch("/event", {method:"POST", headers:{"content-type":"application/json"}, body:JSON.stringify(payload), keepalive:true}).catch(()=>{});
}

function setVolumeLabel(value) {
  const rounded = Math.max(0, Math.min(100, Math.round(Number(value) || 0)));
  volumeDial.value = String(rounded);
  volumeValue.textContent = `${rounded}%`;
}

function outputLabel(output) {
  return output && output.label ? output.label : output.name;
}

function renderOutputs(outputs, defaultSink) {
  const current = audioOutput.value;
  populatingOutputs = true;
  audioOutput.replaceChildren();
  if (!Array.isArray(outputs) || !outputs.length) {
    const option = document.createElement("option");
    option.value = "";
    option.textContent = strings.no_outputs || "No outputs";
    audioOutput.appendChild(option);
    audioOutput.disabled = true;
    populatingOutputs = false;
    return;
  }
  audioOutput.disabled = false;
  for (const output of outputs) {
    if (!output || !output.name) continue;
    const option = document.createElement("option");
    option.value = output.name;
    option.textContent = outputLabel(output);
    audioOutput.appendChild(option);
  }
  if (defaultSink && [...audioOutput.options].some(option => option.value === defaultSink)) {
    audioOutput.value = defaultSink;
  } else if (current && [...audioOutput.options].some(option => option.value === current)) {
    audioOutput.value = current;
  }
  populatingOutputs = false;
}

function refreshState() {
  fetch(`/state?token=${encodeURIComponent(token)}`, {cache:"no-store"})
    .then(r => r.ok ? r.json() : null)
    .then(data => {
      if (!data) return;
      if (typeof data.volume === "number") setVolumeLabel(data.volume);
      renderOutputs(data.outputs, data.default_sink);
    })
    .catch(()=>{});
}

function bindButton(id, payload) {
  const button = document.getElementById(id);
  const fire = ev => {
    ev.preventDefault();
    ev.stopPropagation();
    send(typeof payload === "function" ? payload() : payload);
  };
  button.addEventListener("pointerdown", fire);
  button.addEventListener("touchstart", ev => {
    ev.preventDefault();
    ev.stopPropagation();
  }, {passive:false});
}

function center(touches) {
  let x = 0, y = 0;
  for (const t of touches) { x += t.clientX; y += t.clientY; }
  return {x: x / touches.length, y: y / touches.length, n: touches.length};
}

function disableKeyboardInput() {
  keyboardOpenRequested = false;
  previousKeyboardValue = "";
  keyboardInput.value = "";
  keyboardInput.blur();
  keyboardInput.setAttribute("disabled", "");
  keyboardInput.setAttribute("readonly", "");
  keyboardInput.setAttribute("tabindex", "-1");
  keyboardInput.setAttribute("inputmode", "none");
}

function enableKeyboardInput() {
  keyboardOpenRequested = true;
  previousKeyboardValue = "";
  keyboardInput.value = "";
  keyboardInput.removeAttribute("disabled");
  keyboardInput.removeAttribute("readonly");
  keyboardInput.removeAttribute("tabindex");
  keyboardInput.setAttribute("inputmode", "text");
  keyboardInput.focus({preventScroll:true});
}

pad.addEventListener("touchstart", ev => {
  ev.preventDefault();
  disableKeyboardInput();
  last = center(ev.touches);
  scrollSamples = [];
  didScroll = ev.touches.length >= 2;
  touchStartCount = Math.max(touchStartCount, ev.touches.length);
  touchStartAt = performance.now();
  touchMoved = false;
  if (didScroll) send({type:"scroll_start"});
}, {passive:false});

pad.addEventListener("touchmove", ev => {
  ev.preventDefault();
  if (!last || ev.touches.length < 1) return;
  const now = center(ev.touches);
  const dx = now.x - last.x;
  const dy = now.y - last.y;
  last = now;
  if (Math.abs(dx) + Math.abs(dy) > 10) touchMoved = true;
  if (now.n >= 2) {
    didScroll = true;
    scrollSamples.push({dx, dy, t: performance.now()});
    if (scrollSamples.length > 5) scrollSamples.shift();
    send({type:"scroll", dx, dy});
  } else {
    send({type:"move", dx, dy});
  }
}, {passive:false});

pad.addEventListener("touchend", ev => {
  ev.preventDefault();
  if (ev.touches.length) {
    last = center(ev.touches);
    touchStartCount = Math.max(touchStartCount, ev.touches.length);
    if (ev.touches.length >= 2) didScroll = true;
    return;
  }
  if (touchStartCount >= 3 && !touchMoved && performance.now() - touchStartAt < 360) {
    send({type:"key", key:"back"});
    touchStartCount = 0;
    didScroll = false;
    scrollSamples = [];
    last = null;
    return;
  }
  if (didScroll || scrollSamples.length) {
    const recent = scrollSamples.filter(s => performance.now() - s.t < 160);
    if (recent.length) {
      const dx = recent.reduce((a, s) => a + s.dx, 0) / recent.length;
      const dy = recent.reduce((a, s) => a + s.dy, 0) / recent.length;
      send({type:"scroll_end", dx, dy});
    } else {
      send({type:"scroll_end", dx:0, dy:0});
    }
    scrollSamples = [];
    didScroll = false;
    last = null;
    return;
  }
  const now = Date.now();
  if (now - lastTap < 280) send({type:"click", button:"left"});
  lastTap = now;
  last = null;
}, {passive:false});

bindButton("left", {type:"click", button:"left"});
bindButton("close", {type:"close_app"});
bindButton("web-back", {type:"browser_back"});
bindButton("keyboard", () => {
