audioOutput.addEventListener("change", () => {
  if (populatingOutputs || !audioOutput.value) return;
  send({type:"audio_output_set", sink:audioOutput.value}).then(() => setTimeout(refreshState, 180));
});

keyboardInput.addEventListener("input", () => {
  if (!keyboardOpenRequested) return;
  const value = keyboardInput.value;
  if (value.length > previousKeyboardValue.length && value.startsWith(previousKeyboardValue)) {
    send({type:"text", text:value.slice(previousKeyboardValue.length)});
  } else if (value.length < previousKeyboardValue.length && previousKeyboardValue.startsWith(value)) {
    send({type:"key", key:"backspace", count:previousKeyboardValue.length - value.length});
  } else if (value !== previousKeyboardValue) {
    send({type:"text", text:value});
  }
  previousKeyboardValue = value;
});

keyboardInput.addEventListener("keydown", ev => {
  if (ev.key === "Enter") {
    ev.preventDefault();
    send({type:"key", key:"enter"});
    keyboardInput.value = "";
    previousKeyboardValue = "";
  } else if (ev.key === "Escape") {
    ev.preventDefault();
    disableKeyboardInput();
  }
});
keyboardInput.addEventListener("blur", () => {
  disableKeyboardInput();
});
window.addEventListener("gesturestart", ev => ev.preventDefault(), {passive:false});
window.addEventListener("gesturechange", ev => ev.preventDefault(), {passive:false});
applyTranslations();
refreshState();
