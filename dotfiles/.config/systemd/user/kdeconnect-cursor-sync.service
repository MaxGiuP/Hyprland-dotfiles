[Unit]
Description=Sync KDE Connect Xwayland remote input with the Hyprland cursor (native)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/kdeconnect-cursor-sync
Restart=on-failure
RestartSec=2s
RestartSteps=5
RestartMaxDelaySec=30s

[Install]
WantedBy=graphical-session.target
