[Unit]
Description=Route TV mode windows and handle controller shortcuts
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/tv-mode-daemon
Restart=on-failure
RestartSec=2s
RestartSteps=5
RestartMaxDelaySec=30s

[Install]
WantedBy=graphical-session.target
